{
  "name": "dubhe",
  "version": "2.1.0-beta.8",
  "description": "Provide cli and utility functions for others dubhe project",
  "author": "fgsreally",
  "license": "ISC",
  "keywords": [
    "micro module",
    "module federation",
    "cli"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
